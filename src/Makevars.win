# src/Makevars.win

PKG_LIBS = $(LAPACK_LIBS) $(BLAS_LIBS) $(SHLIB_OPENMP_LIBS) $(FLIBS)

# List all object files
OBJECTS = 00tweedie_params.o rprintf_mod.o Calcs_Real.o Calcs_Imag.o \
          Calcs_Solvers.o Calcs_K.o TweedieIntZones.o Integrands.o \
          gaussianData.o GaussQuadrature.o TweedieIntegration.o

all: $(SHLIB)

$(SHLIB): $(OBJECTS)

# HARD DEPENDENCIES: Windows MUST see these to change the order
Calcs_Real.o: 00tweedie_params.o
Calcs_Imag.o: 00tweedie_params.o
Calcs_Solvers.o: 00tweedie_params.o
Calcs_K.o: Calcs_Solvers.o Calcs_Imag.o 00tweedie_params.o
TweedieIntZones.o: Calcs_K.o 00tweedie_params.o
Integrands.o: Calcs_Real.o
gaussianData.o: 00tweedie_params.o rprintf_mod.o
GaussQuadrature.o: Integrands.o gaussianData.o
TweedieIntegration.o: Integrands.o GaussQuadrature.o TweedieIntZones.o
